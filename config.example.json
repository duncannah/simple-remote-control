{
	"bind": "0.0.0.0",
	"port": 8080,
	"command_timeout_seconds": 30,
	"categories": [
		{
			"name": "System",
			"commands": [
				{
					"id": "uptime",
					"label": "Show Uptime",
					"command": "uptime"
				},
				{
					"id": "reboot",
					"label": "Reboot",
					"command": "systemctl reboot"
				}
			]
		},
		{
			"name": "Services",
			"commands": [
				{
					"id": "restart-nginx",
					"label": "Restart Nginx",
					"command": "systemctl restart nginx"
				},
				{
					"id": "tail-nginx-error",
					"label": "Tail Nginx Error Log",
					"command": "tail -n 50 /var/log/nginx/error.log"
				}
			]
		}
	]
}
